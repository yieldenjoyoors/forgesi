{
  // ForgeSI knot: a Tangled knot on Cloudflare. Go wasm worker over D1;
  // static web (landing + console shell) served from ./web. Git objects in
  // Artifacts (M2b) and the firehose in a Durable Object (M3) come next.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forgesi-knot",
  "main": "dist-gen/worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_als"],

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },

  "rules": [
    { "type": "ESModule", "globs": ["**/*.wasm"], "fallthrough": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forgesi-knot",
      "database_id": "bab284bd-25b3-4af1-a522-ffa158fd7f82",
      "migrations_dir": "internal/cob/migrations"
    }
  ],

  // forgesi.org is the knot origin: landing at /, console at /app,
  // XRPC under /xrpc, identity at /.well-known — one worker, one domain.
  "routes": [
    { "pattern": "forgesi.org", "custom_domain": true }
  ],

  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/xrpc/*", "/.well-known/*", "/git/*", "/did:*"]
  },

  "vars": {
    "KNOT_HOST": "forgesi.org",
    "KNOT_VERSION": "0.1.0",
    "KNOT_AUTH": "service"
  }
}
