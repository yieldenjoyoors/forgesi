{
  // ForgeSI fleet runner: the agent library compiled to wasm, deployed as
  // a plain Worker. The knot wakes it (POST /run) after each tick; the
  // agent clones over HTTP, works with the LLM, pushes, reports. No
  // containers — the agent is pure Go and runs in the Worker runtime.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forgesi-runner",
  "main": "dist-gen/worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_als"],

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },

  "rules": [
    { "type": "ESModule", "globs": ["**/*.wasm"], "fallthrough": true }
  ],

  "vars": {
    "KNOT": "https://forgesi.org"
  }
}
